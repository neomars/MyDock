[Unit]
Description=MyDock - écran du dock (labwc + Chromium en kiosque sur la console 1)
Documentation=https://github.com/neomars/MyDock
ConditionPathExists=/dev/tty0
After=systemd-user-sessions.service plymouth-quit-wait.service mydock-dock.service getty@tty1.service
After=dbus.socket systemd-logind.service
Wants=mydock-dock.service dbus.socket systemd-logind.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=mydock-kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=labwc:wlroots
ExecStart=/usr/bin/labwc --config-dir @ETC@/labwc
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
