[Unit]
Description=MyDock - agent de pilotage du PC (dock tactile)
Documentation=https://github.com/neomars/MyDock
After=graphical-session.target
PartOf=graphical-session.target
# La configuration (jeton, Pi autorisé) est personnelle : le service ne démarre qu'une fois
# « mydock-agent setup » exécuté par l'utilisateur.
ConditionPathExists=%E/mydock/agent.toml

[Service]
Type=simple
ExecStart=/usr/bin/mydock-agent run
Restart=on-failure
RestartSec=3
# L'agent reste discret : le PC garde la priorité.
Nice=5
# Durcissement. Les applications de l'utilisateur ne sont PAS lancées comme enfants de l'agent (elles
# hériteraient de NoNewPrivileges, et un Snap ne démarrerait pas) : l'agent demande au gestionnaire
# systemd de l'utilisateur de les lancer (« systemd-run --user »), voir mydock_agent/launcher.py.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=graphical-session.target
